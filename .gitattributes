#
# Text is stored with LF in the repository and checked out with the platform
# default, so a fresh clone on any host produces the same bytes the tag records.
* text=auto
*.hpp text
*.cpp text
*.md text
*.txt text
*.cmake text
*.ps1 text
*.yml text
CMakeLists.txt text
LICENSE text
